<Window x:Class="Tangerine.Ui.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tangerine"
        Width="330" Height="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Left="-20000" Top="-20000"
        Focusable="False" AllowDrop="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display">
    <!-- 모양은 RadialMenuWindow.xaml.cs 에서 형식 수와 Windows 테마에 맞춰 그린다 -->
    <Canvas x:Name="Root" Width="330" Height="330" RenderTransformOrigin="0.5,0.5">
        <Canvas.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Canvas.RenderTransform>
    </Canvas>
</Window>
